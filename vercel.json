{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/breakage-5",  "destination": "/breakage-5.html"  },
    { "source": "/breakage-10", "destination": "/breakage-10.html" },
    { "source": "/breakage-15", "destination": "/breakage-15.html" },
    { "source": "/breakage-20", "destination": "/breakage-20.html" },
    { "source": "/breakage-25", "destination": "/breakage-25.html" },
    { "source": "/sucesso",     "destination": "/sucesso.html"     }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control",    "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Frame-Options",  "value": "ALLOWALL" },
        { "key": "Referrer-Policy",  "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
